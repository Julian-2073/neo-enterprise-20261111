{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:python && npm run test:node && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:local": "NEO_LOCAL_AUTH=true WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --host 127.0.0.1",
    "db:local": "node scripts/setup-local.mjs",
    "test:ingestion": "node --test tests/ingestion.test.mjs",
    "test:workspace": "node --test tests/workspace-navigation.test.mjs",
    "dev:neo": "node scripts/start-neo.mjs",
    "test:agents": "node --test tests/agents.test.mjs",
    "test:ontology": "node --test tests/ontology.test.mjs",
    "test:materials": "node --test tests/materials.test.mjs tests/materials-full24.test.mjs",
    "test:materials:full24": "node scripts/materials-full24/verify.mjs",
    "test:input-source": "node --test tests/input-source.test.mjs",
    "test:node": "node scripts/test-node.mjs",
    "typecheck": "tsc --noEmit",
    "test:python": "PYTHONPATH=agent-service agent-service/.venv/bin/python -m pytest agent-service/tests",
    "build:local:stable": "node scripts/build-local-stable.mjs",
    "setup:local:stable": "node scripts/seed-stable-simulation.mjs",
    "start:stable": "node scripts/start-local-stable.mjs",
    "start:stable:chat": "NEO_MANUAL_CHAT=true node scripts/start-local-stable.mjs",
    "backend-map": "node scripts/generate-backend-map.mjs",
    "prestorybook": "npm run backend-map",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open --disable-telemetry",
    "prebuild-storybook": "npm run backend-map",
    "build-storybook": "storybook build --disable-telemetry",
    "test:development-tools": "node --test tests/backend-map.test.mjs tests/delivery-tools.test.mjs",
    "synthetic:generate": "python3 scripts/synthetic-data/generate.py",
    "synthetic:validate": "python3 scripts/synthetic-data/validate.py",
    "synthetic:catalog": "python3 scripts/synthetic-data/catalog.py",
    "synthetic:verify-backend": "node scripts/synthetic-data/verify-backend.mjs",
    "knowledge:build": "node scripts/build-business-knowledge.mjs",
    "tools:handoff": "python3 agent-service/scripts/handoff_manifest.py",
    "build:isolated": "node agent-service/scripts/build_isolated.mjs",
    "synthetic:oracle": "python3 scripts/synthetic-data/oracle.py",
    "synthetic:check": "npm run synthetic:generate && npm run synthetic:oracle && npm run synthetic:validate && npm run synthetic:verify-backend && npm run synthetic:catalog",
    "start:acceptance": "NEO_LOCAL_OUTPUT=outputs/backend-closure/prior-data NEO_WEB_PORT=3112 NEO_AGENT_PORT=8148 node scripts/start-local-stable.mjs",
    "evaluate:frozen": "node scripts/evaluate-frozen-cases.mjs",
    "evaluate:frozen:live": "node scripts/evaluate-frozen-live.mjs",
    "evaluate:frozen:prepare": "node scripts/prepare-frozen-runtime.mjs",
    "evaluate:frozen:provider": "PYTHONPATH=agent-service agent-service/.venv/bin/python -m neo_agent.frozen_provider_evaluation"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.4",
    "papaparse": "5.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.1.2",
    "@xyflow/react": "12.12.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "27.4.0",
    "react-server-dom-webpack": "19.2.6",
    "storybook": "10.6.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
