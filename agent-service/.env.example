# One Chat Completions model with tools and JSON output. Key stays server-side.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Reuse the locally configured Firecrawl MCP launcher; no model-selected commands.
NEO_MARKET_PROVIDER=firecrawl_mcp
NEO_FIRECRAWL_MCP_COMMAND=
# Optional alternate provider: set NEO_MARKET_PROVIDER=tavily.
TAVILY_API_KEY=
# Generated by scripts/start-neo.mjs for local use. Never expose in the browser.
NEO_SERVICE_TOKEN=
# Optional absolute path; by default state/agent.sqlite inside agent-service.
# NEO_AGENT_DB=
