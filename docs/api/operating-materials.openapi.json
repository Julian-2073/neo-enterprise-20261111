  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Upload": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "file",
              "kind",
              "sourceName",
              "dataNature",
              "templateVersion",
              "coverageStart",
              "coverageEnd"
            ],
            "properties": {
              "file": {
                "type": "string",
                "format": "binary"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "roles",
                  "products",
                  "skus",
                  "channels",
                  "warehouses",
                  "customers",
                  "customer_identities",
                  "arrivals",
                  "supply_rules"
                ]
              },
              "sourceName": {
                "type": "string"
              },
              "dataNature": {
                "type": "string",
                "enum": [
                  "demo",
                  "business"
                ]
              },
              "templateVersion": {
                "const": "2"
              },
              "coverageStart": {
                "type": "string",
                "format": "date"
              },
              "coverageEnd": {
                "type": "string",
                "format": "date"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "file",
              "kind",
              "sourceName",
              "dataNature",
              "templateVersion",
              "coverageStart",
              "coverageEnd"
            ],
            "properties": {
              "file": {
                "type": "string",
                "format": "binary"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "events",
                  "orders",
                  "inventory",
                  "expenses"
                ]
              },
              "sourceName": {
                "type": "string"
              },
              "dataNature": {
                "type": "string",
                "enum": [
                  "demo",
                  "business"
                ]
              },
              "templateVersion": {
                "type": "string",
                "enum": [
                  "1",
                  "2"
                ]
              },
              "coverageStart": {
                "type": "string",
                "format": "date"
              },
              "coverageEnd": {
                "type": "string",
                "format": "date"
              }
            }
          }
        ]
      },
      "CustomerFunnel": {
        "type": "object",
        "required": [
          "cohortStage",
          "conversionWindowDays",
          "channelPolicy"
        ],
        "properties": {
          "cohortStage": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "A3"
            ]
          },
          "conversionWindowDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "channelPolicy": {
            "type": "string",
            "enum": [
              "same_channel",
              "any"
            ]
          }
        }
      },
      "SnapshotInput": {
        "type": "object",
        "required": [
          "dataNature"
        ],
        "properties": {
          "dataNature": {
            "type": "string",
            "enum": [
              "demo",
              "business"
            ]
          },
          "asOf": {
            "type": "string",
            "format": "date"
          },
          "periodStart": {
            "type": "string",
            "format": "date"
          },
          "periodEnd": {
            "type": "string",
            "format": "date"
          },
          "productId": {
            "type": [
              "string",
              "null"
            ]
          },
          "channel": {
            "type": [
              "string",
              "null"
            ]
          },
          "knownAt": {
            "type": "string",
            "format": "date-time",
            "description": "带时区，不晚于现在；实际提交时间作为可用截止。"
          },
          "customerFunnel": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CustomerFunnel"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "FrozenObject": {
        "type": "object",
        "required": [
          "id",
          "factId",
          "batchId",
          "row",
          "effectiveFrom",
          "effectiveTo",
          "availableAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "factId": {
            "type": "string"
          },
          "batchId": {
            "type": "string"
          },
          "row": {
            "type": "integer",
            "minimum": 2
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "effectiveTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "availableAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceKnownAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Source claimed knowledge time; not system availableAt."
          },
          "sourceVersion": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sourceStatus": {
            "type": [
              "string",
              "null"
            ]
          },
          "receivedUnits": {
            "type": [
              "integer",
              "null"
            ]
          },
          "units": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "planned",
              "rescheduled",
              "partially_received",
              "received",
              "cancelled",
              null
            ]
          },
          "qualificationBasis": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "minimum_sellable_units",
              "inventory_safety_units",
              null
            ]
          }
        }
      },
      "Materials": {
        "type": "object",
        "required": [
          "version",
          "dataProvenance",
          "knownAt",
          "availability",
          "domain",
          "customerAnalysis",
          "customerLinks",
          "supply",
          "quality",
          "sourceFactIds"
        ],
        "properties": {
          "version": {
            "const": "operating-materials-v1"
          },
          "dataProvenance": {
            "enum": [
              "SYNTHETIC_DEMO",
              "BUSINESS_UNVERIFIED"
            ]
          },
          "knownAt": {
            "type": "string",
            "format": "date-time"
          },
          "availability": {
            "const": "system_recorded"
          },
          "domain": {
            "type": "object",
            "properties": {
              "products": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FrozenObject"
                }
              },
              "skus": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FrozenObject"
                }
              },
              "roles": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FrozenObject"
                }
              },
              "channels": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FrozenObject"
                }
              },
              "warehouses": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FrozenObject"
                }
              },
              "customers": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FrozenObject"
                }
              },
              "customerIdentities": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FrozenObject"
                }
              },
              "arrivals": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FrozenObject"
                }
              },
              "supplyRules": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FrozenObject"
                }
              }
            }
          },
          "customerAnalysis": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "ready",
                  "partial",
                  "unconfigured"
                ]
              },
              "cohortCustomers": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "matureCustomers": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "immatureCustomers": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "convertedCustomers": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "conversionRate": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "rule": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/CustomerFunnel"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stageCustomerCounts": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "unidentifiedRecords": {
                "type": "integer"
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "customerLinks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "factId",
                "customerId",
                "linkedOrderId",
                "linkedOrderLineId"
              ],
              "properties": {
                "factId": {
                  "type": "string"
                },
                "customerId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "linkedOrderId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "linkedOrderLineId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "supply": {
            "type": "object",
            "description": "products净数量/已观测可售/在途/成本/ETA；roles有效SKU个数/已观测/按规则评价/周序列。不把缺数据当零。"
          },
          "quality": {
            "type": "object"
          },
          "sourceFactIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SnapshotAdditions": {
        "type": "object",
        "properties": {
          "knownAt": {
            "type": "string",
            "format": "date-time"
          },
          "domain": {
            "type": "object"
          },
          "data": {
            "type": "object",
            "properties": {
              "materials": {
                "$ref": "#/components/schemas/Materials"
              }
            }
          }
        }
      }
    }
  }
